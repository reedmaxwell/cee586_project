{
    "name": "CEE 586 project (ParFlow-CLM)",
    "image": "ghcr.io/reedmaxwell/cee586_project:latest",
    "otherPortsAttributes": {
        "onAutoForward": "ignore"
    },
    "customizations": {
        "codespaces": {
            "openFiles": ["START_HERE.md"]
        },
        "vscode": {
            "settings": {
                "python.defaultInterpreterPath": "/home/ubuntu/.venv/bin/python",
                "workbench.editorAssociations": {
                    "*.md": "vscode.markdown.preview.editor"
                }
            },
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-toolsai.jupyter"
            ]
        }
    },
    "postCreateCommand": "python -m ipykernel install --user --name subsetting-shortcourse --display-name \"Python (PFCLM)\"",
    "remoteUser": "ubuntu"
}
